    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Now Playing"
        android:layout_marginTop="20dp"
        android:textColor="#808080"
        android:fontFamily="casual"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/albumArt"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_marginTop="30dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView"
        app:srcCompat="@drawable/albumart" />

    <TextView
        android:id="@+id/songName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="24dp"
        app:layout_constraintStart_toStartOf="@id/albumArt"
        app:layout_constraintTop_toBottomOf="@id/albumArt"
        android:layout_marginTop="30dp"/>

    <TextView
        android:id="@+id/artistName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:textSize="12dp"
        android:textColor="#808080"
        app:layout_constraintTop_toBottomOf="@id/songName"
        app:layout_constraintStart_toStartOf="@id/songName"/>

    <SeekBar
        android:id="@+id/songProgress"
        android:layout_width="300dp"
        android:layout_height="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.485"
        app:layout_constraintTop_toBottomOf="@id/artistName"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        tools:layout_editor_absoluteY="494dp" />

<!--    <com.google.android.material.floatingactionbutton.FloatingActionButton-->
<!--        android:id="@+id/playPause"-->
<!--        android:layout_width="wrap_content"-->
<!--        android:layout_height="wrap_content"-->
<!--        android:clickable="true"-->
<!--        android:contentDescription="playbutton"-->
<!--        android:layout_marginTop="30dp"-->
<!--        app:layout_constraintEnd_toEndOf="parent"-->
<!--        app:layout_constraintTop_toBottomOf="@id/songProgress"-->
<!--        app:layout_constraintStart_toStartOf="parent"-->
<!--        app:srcCompat="@android:drawable/ic_media_play"-->
<!--        tools:layout_editor_absoluteY="554dp" />-->
    <ImageButton
        android:id="@+id/playPause"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginTop="30dp"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:scaleType="fitCenter"
        app:tint="@android:color/white"
        android:src="@drawable/pausebtn"
        app:layout_constraintEnd_toStartOf="@+id/nextBtn"
        app:layout_constraintStart_toEndOf="@+id/prevBtn"
        app:layout_constraintTop_toBottomOf="@id/songProgress" />

    <ImageButton
        android:id="@+id/prevBtn"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:src="@drawable/prevbtn"
        android:scaleType="fitCenter"
        app:tint="@android:color/white"
        android:background="@android:color/transparent"
        app:layout_constraintStart_toStartOf="@id/songProgress"
        app:layout_constraintTop_toBottomOf="@id/songProgress"
        android:layout_marginTop="30dp"
        android:layout_marginLeft="20dp"
        tools:layout_editor_absoluteY="554dp" />

    <ImageButton
        android:id="@+id/nextBtn"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:src="@drawable/nextbtn"
        android:scaleType="fitCenter"
        app:tint="@android:color/white"
        android:background="@android:color/transparent"
        app:layout_constraintEnd_toEndOf="@id/songProgress"
        app:layout_constraintTop_toBottomOf="@id/songProgress"
        android:layout_marginTop="30dp"

        tools:layout_editor_absoluteY="554dp" />

